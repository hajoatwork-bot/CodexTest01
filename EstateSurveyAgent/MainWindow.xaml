<Window x:Class="EstateSurveyAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EstateSurveyAgent.ViewModels"
        Title="Estate Survey Agent" Height="600" Width="1000">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0 0 0 16">
            <Button Content="Folyamatban" Width="140" Margin="0 0 12 0" Command="{Binding MarkInProgressCommand}" />
            <Button Content="Lezárás" Width="140" Command="{Binding MarkCompletedCommand}" />
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Azonosító" Binding="{Binding TaskId}" Width="*" />
                <DataGridTextColumn Header="Cím" Binding="{Binding Title}" Width="*" />
                <DataGridTextColumn Header="Ingatlan" Binding="{Binding Address}" Width="*" />
                <DataGridTextColumn Header="Státusz" Binding="{Binding Status}" Width="*" />
                <DataGridTextColumn Header="Frissítve" Binding="{Binding UpdatedAtUtc}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
